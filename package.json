{
  "name": "localprocessor-movies",
  "productName": "LocalProcessor-Movies",
  "version": "1.1.0",
  "description": "Motor de transcodificación VOD: convierte películas a HLS/DASH para que otro sistema las sirva por streaming",
  "author": "Renato Letelier",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json",
    "postinstall": "install-electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-bins": "tsx scripts/fetch-bins.ts",
    "process": "tsx scripts/process.ts",
    "make-sample": "tsx scripts/make-sample.ts",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@electron-toolkit/utils": "4.0.0",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/websocket": "11.3.0",
    "fast-xml-parser": "5.11.1",
    "fastify": "5.12.4"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "license": "MIT"
}
